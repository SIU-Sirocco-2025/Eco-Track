# Sao chép vào thư mục riêng ngoài Git; điền credential được quản trị Core cấp.
CORE_API_URL=http://127.0.0.1:18088/api/core/connector
CORE_CONNECTOR_TOKEN=
MONGODB_URL=mongodb://127.0.0.1:27028/ecotrack_sirocco_tests
SIROCCO_DEFINITION_ID=
SIROCCO_REVIEWER_ID=operator-reviewer

# Bật SSO sau khi quản trị apply oidc-client.json và cấp client role.
# SIROCCO_REVIEWER_ID ở trên cần đổi thành user ID (sub) trong Keycloak.
SIROCCO_OIDC_ISSUER=
SIROCCO_OIDC_CLIENT_ID=ecotrack-review
SIROCCO_OIDC_CLIENT_SECRET=
SIROCCO_REVIEW_ORIGIN=http://localhost:18085
SIROCCO_REVIEW_SESSION_SECRET=
SIROCCO_REVIEW_ARCHIVE=false
PORT=18085
SESSION_SECRET=
