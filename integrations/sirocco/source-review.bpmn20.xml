<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="urn:ecotrack:source-review">
  <process id="ecotrack-source-review" name="Xác minh nguồn quan trắc" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="to-review" sourceRef="start" targetRef="review"/>
    <userTask id="review" name="Xác minh nguồn, đơn vị và cửa sổ đo" flowable:assignee="${reviewer}"/>
    <sequenceFlow id="to-end" sourceRef="review" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
